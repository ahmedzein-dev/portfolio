---
import { getContent } from '../data/content';
import { langOf, otherPath } from '../i18n';

// The bar at the top of every page. On the home page the links jump within it; elsewhere they lead back
// to its sections. Beside the theme button, a two-way AR | EN switch: the page's language lit, the other a link
// to this same page in that language.
const lang = langOf(Astro.url);
const { t, profile, link } = getContent(lang);
const onHome = Astro.url.pathname === link('/');
const to = (hash: string) => (onHome ? hash : link(`/${hash}`));
const other = otherPath(Astro.url);
---

<header class="topbar">
  <a class="brand" href={link('/')} aria-label={t.home(profile.name)}><span class="az" aria-hidden="true">AZ</span><span class="nm">{profile.name}</span></a>
  <nav class="toplinks" aria-label={t.nav.label}>
    <a href={to('#work')}>{t.nav.work}</a>
    <a href={to('#open-source')}>{t.nav.openSource}</a>
    <a href={to('#experience')}>{t.nav.experience}</a>
    <a href={to('#contact')}>{t.nav.contact}</a>
  </nav>
  {/* AR | EN in that order on both pages (global.css reverses the row on /ar/), like a switch, not a list that flips with the page. */}
  <div class="lang-switch" role="group" aria-label={lang === 'ar' ? 'اللغة' : 'Language'}>
    {lang === 'ar' ? (
      <span aria-current="true">AR</span>
    ) : (
      <a href={other.path} lang="ar" hreflang="ar" title={t.switchTo.title}>AR</a>
    )}
    {lang === 'en' ? (
      <span aria-current="true">EN</span>
    ) : (
      <a href={other.path} lang="en" hreflang="en" title={t.switchTo.title}>EN</a>
    )}
  </div>
  <button class="theme-btn" id="theme-btn" type="button" aria-label={t.theme}>
    {/* The sun in dark, to switch to light; the moon in light, to switch to dark (global.css shows one). */}
    <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.9"></circle><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.55 1.55M17.15 17.15l1.55 1.55M5.3 18.7l1.55-1.55M17.15 6.85l1.55-1.55" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path></svg>
    <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"></path></svg>
  </button>
</header>
