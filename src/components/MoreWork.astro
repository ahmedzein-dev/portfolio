---
import { Image } from 'astro:assets';
import { moreWork } from '../data/site';
import StoreLinks from './StoreLinks.astro';

// Newest first: by the year a project ended ("now" counts as latest), then by the year it began.
const span = (year: string) => {
  const [from, to = from] = year.split(' to ');
  return { from: Number(from), to: to === 'now' ? Infinity : Number(to) };
};
const newestFirst = (a: string, b: string) => span(b).to - span(a).to || span(b).from - span(a).from;
// The case studies in Selected Work are not repeated here.
const cards = [...moreWork].sort((a, b) => newestFirst(a.year, b.year));
// On phones the list starts at four; more than that gets a Show all button.
const collapse = cards.length > 4;
---

<div class="mw-bar">
  <div class="mw-filters" id="mw-filters" role="group" aria-label="Filter projects">
    <button class="chip" type="button" data-f="all" aria-pressed="true">All</button>
    <button class="chip" type="button" data-f="mobile" aria-pressed="false">Mobile</button>
    <button class="chip" type="button" data-f="web" aria-pressed="false">Web and desktop</button>
  </div>
  {/* Phones only: the list of rows, or a grid of screenshots. */}
  <div class="mw-view" id="mw-view" role="group" aria-label="Layout">
    <button type="button" data-view="list" aria-pressed="false" aria-label="List">
      <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="2.5" width="4" height="4" rx="1"></rect><rect x="1.5" y="9.5" width="4" height="4" rx="1"></rect><rect x="7.5" y="3.5" width="7" height="2" rx="1"></rect><rect x="7.5" y="10.5" width="7" height="2" rx="1"></rect></svg>
    </button>
    <button type="button" data-view="grid" aria-pressed="true" aria-label="Grid">
      <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1.2"></rect><rect x="9" y="1.5" width="5.5" height="5.5" rx="1.2"></rect><rect x="1.5" y="9" width="5.5" height="5.5" rx="1.2"></rect><rect x="9" y="9" width="5.5" height="5.5" rx="1.2"></rect></svg>
    </button>
  </div>
</div>

<ul class="mw-grid" id="mw-grid" data-view="grid" data-collapsed={collapse ? '' : undefined}>
  {cards.map((p) => (
    <li data-id={p.id} data-tags={p.tags.join(' ')} id={p.id}>
      <button class="mw-card" type="button" data-id={p.id} aria-haspopup="dialog">
        <span class="thumb">
          <Image src={p.thumb} alt="" widths={[360, 540, 720, 1080]} sizes="(min-width: 1100px) 260px, (min-width: 900px) 30vw, (min-width: 540px) 45vw, 90vw" />
        </span>
        <span class="body">
          <span class="yr">{p.year} · {p.platforms}</span>
          <h3>{p.name}</h3>
          <span class="sm">{p.summary}</span>
        </span>
      </button>
      <template id={`mw-${p.id}`}>
        <p class="label">{p.year} · {p.platforms}</p>
        <h2 id="drawer-title">{p.name}</h2>
        {p.links.length > 0 && <StoreLinks links={p.links} />}
        {p.film ? (
          <figure class="film film-drawer">
            <video controls playsinline preload="none" poster={p.film.poster} aria-label={p.film.title}>
              <source src={p.film.src} type="video/mp4" />
            </video>
            <figcaption><span class="film-len">{p.film.length}</span> {p.film.caption}</figcaption>
          </figure>
        ) : (
          <Image class="drawer-img" src={p.image} alt={`${p.name} screens`} widths={[460, 920]} sizes="460px" />
        )}
        <p>{p.description}</p>
        <ul>
          {p.points.map((pt) => <li>{pt}</li>)}
        </ul>
      </template>
    </li>
  ))}
</ul>
{collapse && <button class="mw-all" id="mw-all" type="button">Show all {cards.length} projects</button>}

<dialog class="drawer" id="drawer" aria-labelledby="drawer-title">
  <div class="drawer-inner">
    <div class="drawer-top">
      <span class="label">Project</span>
      <button class="icon-btn" id="drawer-close" type="button" aria-label="Close">
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <div id="drawer-body" class="drawer-inner" style="padding:0"></div>
  </div>
</dialog>
