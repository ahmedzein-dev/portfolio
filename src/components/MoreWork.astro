---
import { Image } from 'astro:assets';
import { getContent } from '../data/content';
import { langOf } from '../i18n';

// Every project, newest first (content.ts), each tile opening its case study. Under All, the ones already in
// Selected Work stay out; a filter brings back the ones it matches, so Web and desktop shows every web and desktop app.
const { projectCards: cards, t, link } = getContent(langOf(Astro.url));
---

<div class="mw-bar">
  <div class="mw-filters" id="mw-filters" role="group" aria-label={t.more.filter}>
    <button class="chip" type="button" data-f="all" aria-pressed="true">{t.more.all}</button>
    <button class="chip" type="button" data-f="mobile" aria-pressed="false">{t.more.mobile}</button>
    <button class="chip" type="button" data-f="web" aria-pressed="false">{t.more.web}</button>
  </div>
</div>

<ul class="mw-grid" id="mw-grid">
  {cards.map((c) => (
    <li data-tags={c.tags.join(' ')} data-featured={c.featured ? '' : undefined} data-id={c.featured ? undefined : c.slug} hidden={c.featured}>
      <a class="mw-card" href={link(`/work/${c.slug}/`)}>
        {/* Phones and tablets in device bodies on a stage tinted with the app's colour, two of them tilted and
            overlapping like a Selected Work card; hover (or the middle of the screen on touch) spreads them apart.
            A project with no such screens (Gainz AI's mockup) shows its thumbnail. */}
        <span class="thumb" data-tile={c.slug}>
          {c.screens.length > 0 ? (
            <span class={`mw-devs ${c.screens[0].kind === 'tablet' ? 'tablets' : 'phones'}`} aria-hidden="true">
              {c.screens.map((s, j) => (
                <span class={`mw-dev p${j + 1}`}>
                  {s.kind === 'tablet' ? (
                    <Image src={s.src} alt="" widths={[260, 520]} sizes="(min-width: 900px) 140px, 26vw" quality={88} />
                  ) : (
                    <Image src={s.src} alt="" widths={[180, 360]} sizes="(min-width: 900px) 92px, 17vw" quality={88} />
                  )}
                </span>
              ))}
            </span>
          ) : (
            <Image src={c.thumb} alt="" widths={[360, 540, 720, 1080]} sizes="(min-width: 1100px) 260px, (min-width: 900px) 30vw, (min-width: 540px) 45vw, 90vw" />
          )}
        </span>
        <span class="body">
          <span class="yr">{c.year} · {c.platforms}</span>
          <h3>{c.name}</h3>
          <span class="sm">{c.summary}</span>
          <span class="mw-more">{t.more.open}</span>
        </span>
      </a>
    </li>
  ))}
</ul>
<button class="mw-all" id="mw-all" type="button" aria-expanded="false" aria-controls="mw-grid">
  <span>{t.more.showAll(cards.length)}</span>
  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
</button>
