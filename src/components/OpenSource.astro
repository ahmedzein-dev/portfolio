---
import { Image } from 'astro:assets';
import { packages } from '../data/site';

// Live numbers from pub.dev at build time; the stored values are the fallback.
type Stats = { points: string; likes?: number; downloads30?: number; version: string };

async function stats(name: string, fallback: Stats): Promise<Stats> {
  try {
    const [scoreRes, pkgRes] = await Promise.all([
      fetch(`https://pub.dev/api/packages/${name}/score`, { signal: AbortSignal.timeout(6000) }),
      fetch(`https://pub.dev/api/packages/${name}`, { signal: AbortSignal.timeout(6000) }),
    ]);
    if (!scoreRes.ok || !pkgRes.ok) return fallback;
    const score = await scoreRes.json();
    const pkg = await pkgRes.json();
    return {
      points: `${score.grantedPoints}/${score.maxPoints}`,
      likes: score.likeCount,
      downloads30: score.downloadCount30Days,
      version: pkg.latest?.version ?? fallback.version,
    };
  } catch {
    return fallback;
  }
}

const rows = await Promise.all(packages.map(async (p) => ({ ...p, stats: await stats(p.name, p.fallback) })));
---

<div class="pkgs" data-swipe="Packages">
  {rows.map((p) => (
    <article class="pkg" data-name={p.name}>
      {p.name === 'draggable_floating_window' && (
        <div class="pkg-visual">
          {/* The example app, recorded as is (the package's README GIF, cropped to where the windows move).
              site.ts plays it only while the card is on screen; under reduced motion the poster stays. */}
          <video class="dfw-demo" muted loop playsinline preload="none" poster="/films/dfw-demo.jpg" aria-label="The draggable_floating_window example app: notes, tasks and a calculator in windows being dragged, resized, stacked and minimized">
            <source src="/films/dfw-demo.mp4" type="video/mp4" />
          </video>
        </div>
      )}
      {p.name === 'document_camera_frame' && (
        <div class="pkg-visual dcf" aria-hidden="true"><span class="card"><i class="scan"></i></span><i class="c c1"></i><i class="c c2"></i><i class="c c3"></i><i class="c c4"></i></div>
      )}
      {p.name === 'scroll_highlight_text' && (
        <div class="pkg-visual sht" aria-hidden="true">
          Search, <mark class="cur">highlight</mark> and step through matches. Every <mark>highlight</mark> is counted.
          <span class="ar">ابحث وحدد كل <mark>نتيجة</mark> في النص</span>
          <span class="cnt">1 of 3</span>
        </div>
      )}
      <div class="pkg-head">
        <h3><a href={`https://pub.dev/packages/${p.name}`}>{p.name}</a></h3>
        <a class="pkg-gh" href={p.github} aria-label={`${p.name} source on GitHub`} title="Source on GitHub" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3"></path></svg>
        </a>
      </div>
      <p>{p.description}{p.note && <> {p.note}</>}</p>
      <dl class="pkg-stats">
        <div><dt>Points</dt><dd>{p.stats.points}</dd></div>
        {p.stats.likes ? <div><dt>Likes</dt><dd>{p.stats.likes}</dd></div> : null}
        {p.stats.downloads30 ? <div><dt>Downloads</dt><dd>{p.stats.downloads30.toLocaleString('en')} / 30 days</dd></div> : null}
        <div><dt>Version</dt><dd>{p.stats.version}</dd></div>
      </dl>
    </article>
  ))}
</div>
