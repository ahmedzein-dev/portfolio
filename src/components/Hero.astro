---
import { Picture } from 'astro:assets';
import { profile, proof } from '../data/site';
---

<header class="topbar">
  <a class="brand" href="/" aria-label={`${profile.name}, home`}><span class="az" aria-hidden="true">AZ</span><span class="nm">{profile.name}</span></a>
  <nav class="toplinks" aria-label="Main">
    <a href="#work">Work</a>
    <a href="#open-source">Open source</a>
    <a href="#experience">Experience</a>
    <a href="#contact">Contact</a>
  </nav>
  <button class="theme-btn" id="theme-btn" type="button" aria-label="Change theme">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5a6.5 6.5 0 1 0 0 13z" fill="currentColor"></path><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"></circle></svg>
  </button>
</header>

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-id">
    <figure class="hero-avatar">
      <Picture
        src={profile.photo}
        alt={profile.name}
        widths={[96, 160, 240]}
        sizes="80px"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <div class="hero-meta">
      <p class="hero-name">{profile.name}</p>
      <p class="eyebrow">{profile.title} · {profile.location}</p>
      <button class="status" id="status-btn" type="button" aria-expanded="false" aria-controls="status-panel">
        <i aria-hidden="true"></i>
        <span><span class="long">{profile.availability.long}</span><span class="short">{profile.availability.short}</span></span>
        <svg class="chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </button>
      <div class="status-panel" id="status-panel" hidden>
        {profile.now.map((row) => (
          <div><span>{row.label}</span>{row.value}</div>
        ))}
      </div>
    </div>
  </div>
  <div class="hero-text">
    <h1 id="hero-title">{profile.headline}</h1>
    <p class="hero-sub">{profile.intro}</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="#work">See the work</a>
      <button class="btn btn-ghost" type="button" data-copy={profile.email} data-copy-msg="Email copied">Copy email</button>
    </div>
  </div>
</section>

<ul class="proof" aria-label="In numbers">
  {proof.map((p) => (
    <li>
      <a href={p.href}>
        <b data-count={p.count} data-decimals={p.decimals} data-prefix={p.prefix} data-suffix={p.suffix}>{p.value}</b>
        <span>{p.label}</span>
      </a>
    </li>
  ))}
</ul>
