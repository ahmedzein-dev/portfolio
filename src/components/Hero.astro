---
import { profile, proof } from '../data/site';
---

<header class="topbar">
  <a class="brand" href="/" aria-label={`${profile.name}, home`}><span class="az" aria-hidden="true">AZ</span><span class="nm">{profile.name}</span></a>
  <nav class="toplinks" aria-label="Main">
    <a href="#work">Work</a>
    <a href="#open-source">Open source</a>
    <a href="#experience">Experience</a>
    <a href="#contact">Contact</a>
  </nav>
  <button class="theme-btn" id="theme-btn" type="button" aria-label="Change theme">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5a6.5 6.5 0 1 0 0 13z" fill="currentColor"></path><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"></circle></svg>
  </button>
</header>

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-id">
    <figure class="hero-avatar">
      {/* Pre-sized and lightly sharpened from the original photo (public/photo), so no second compression softens it. */}
      <img
        src="/photo/ahmed-zein-240.jpg"
        srcset="/photo/ahmed-zein-120.jpg 1x, /photo/ahmed-zein-240.jpg 2x, /photo/ahmed-zein-360.jpg 3x, /photo/ahmed-zein-480.jpg 4x"
        width="120"
        height="120"
        alt={profile.name}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
    <div class="hero-meta">
      <p class="hero-name">{profile.name}</p>
      <p class="eyebrow">{profile.title} · {profile.location}</p>
      <button class="status" id="status-btn" type="button" aria-expanded="false" aria-controls="status-panel">
        <i aria-hidden="true"></i>
        <span><span class="long">{profile.availability.long}</span><span class="short">{profile.availability.short}</span></span>
        <svg class="chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </button>
      <div class="status-panel" id="status-panel" hidden>
        {profile.now.map((row) => (
          <div>
            <span>{row.label}</span>
            {/* site.ts types .vt when the panel opens; .vg holds the size, screen readers get .sr-only. */}
            <span class="v"><span class="sr-only">{row.value}</span><span class="vg" aria-hidden="true">{row.value}</span><span class="vt" aria-hidden="true">{row.value}</span></span>
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="hero-text">
    <h1 id="hero-title">{profile.headline}</h1>
    <p class="hero-sub">{profile.intro}</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="#work">See the work</a>
      <button class="btn btn-ghost" type="button" data-copy={profile.email} data-copy-msg="Email copied">Copy email</button>
      <a class="btn btn-ghost" href={profile.cv} target="_blank" rel="noopener">
        <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19.5h14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        Download CV
      </a>
    </div>
  </div>
</section>

<ul class="proof" aria-label="In numbers">
  {proof.map((p) => (
    <li>
      <a href={p.href}>
        <b data-count={p.count} data-from={p.from} data-value={p.value} data-decimals={p.decimals} data-prefix={p.prefix} data-suffix={p.suffix}>{p.value}</b>
        <span>{p.label}</span>
      </a>
    </li>
  ))}
</ul>
<script is:inline>
  // Set the numbers to where they count up from before the first paint, so they never flash their final value.
  // site.ts runs the count; if it never loads, the final values come back.
  (function () {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    var els = document.querySelectorAll('.proof [data-count]');
    els.forEach(function (el) {
      var d = el.dataset;
      el.textContent = (d.prefix || '') + Number(d.from || 0).toFixed(Number(d.decimals || 0)) + (d.suffix || '');
      d.state = 'start';
    });
    setTimeout(function () {
      els.forEach(function (el) {
        if (el.dataset.state === 'start') el.textContent = el.dataset.value;
      });
    }, 4000);
  })();
</script>
