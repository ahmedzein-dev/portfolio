---
import { getContent } from '../data/content';
import { langOf } from '../i18n';

const { capabilities, capabilityTiles, education, experience, t } = getContent(langOf(Astro.url));
// An English title and company read as one Latin phrase, so they take an English comma even on /ar/.
const comma = (role: string) => (/[\u0600-\u06FF]/.test(role) ? t.comma : ', ');
---

<div class="two">
  <div id="experience" data-section={t.sections.experience.label} data-num="4" class="section" style="padding-top:0">
    <div class="section-head">
      <p class="label"><span class="n">4</span> {t.sections.experience.label}</p>
      <h2>{t.sections.experience.title}</h2>
    </div>
    <ol class="timeline">
      {experience.map((e, i) => (
        <li class={e.current ? 'now' : undefined} style={`--k:${experience.length - 1 - i}`}>
          <p class="tl-when">{e.when} · {e.place}</p>
          <h3 style="font-size:1.05rem">{e.role}{comma(e.role)}{e.org}</h3>
          <p class="tl-note">{e.note}</p>
        </li>
      ))}
    </ol>
    <p class="edu">{education}</p>
  </div>
  <div>
    <div class="section-head">
      <p class="label">{t.sections.capabilities.label}</p>
      <h2>{t.sections.capabilities.title}</h2>
      <p class="lede">{t.sections.capabilities.lede}</p>
    </div>
    <div class="cap-btns" role="group" aria-label={t.sections.capabilities.label}>
      {capabilities.map((c) => (
        <button class="cap-btn" type="button" data-ids={c.ids.join(' ')} data-proof={c.proof} aria-pressed="false">{c.name}</button>
      ))}
    </div>
    <ul class="cap-tiles">
      {capabilityTiles.map((t) => (
        <li class="cap-tile" data-id={t.id}>{t.name}<small>{t.note}</small></li>
      ))}
    </ul>
    {/* site.ts types the proof into .cap-typed; .cap-ghost holds its full size so nothing jumps, and
        screen readers get the whole sentence at once from the live region. */}
    <p class="cap-out" id="cap-out">
      <span class="sr-only" aria-live="polite"></span>
      <span class="cap-ghost" aria-hidden="true"></span>
      <span class="cap-typed" aria-hidden="true"></span>
    </p>
  </div>
</div>
