---
import CasePage from '../../components/CasePage.astro';
import { getContent } from '../../data/content';

export function getStaticPaths() {
  const { caseStudies } = getContent('en');
  return caseStudies.map((p, i) => ({
    params: { slug: p.slug },
    props: { project: p, next: caseStudies[(i + 1) % caseStudies.length] },
  }));
}
---

<CasePage {...Astro.props} />
