---
import Base from '../../layouts/Base.astro';
import { moreWork, profile } from '../../data/site';

// Amber Drive has no case study of its own, but its film needs a page to link to (CV, LinkedIn)
// with its own preview, since the quick view on the home page shares the home page's preview.
const p = moreWork.find((w) => w.id === 'amber-drive')!;
const film = p.film!;
---

<Base title={`${p.name}: ${p.summary.replace(/\.$/, '')} · ${profile.name}`} description={p.description} image="/share/amber-drive.jpg">
  <main class="page" id="main">
    <header class="topbar">
      <a class="brand" href="/"><span class="az" aria-hidden="true">AZ</span><span class="nm">{profile.name}</span></a>
      <nav class="toplinks" aria-label="Main">
        <a href="/#work">Work</a>
        <a href="/#open-source">Open source</a>
        <a href="/#experience">Experience</a>
        <a href="/#contact">Contact</a>
      </nav>
      <button class="theme-btn" id="theme-btn" type="button" aria-label="Change theme">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5a6.5 6.5 0 1 0 0 13z" fill="currentColor"></path><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"></circle></svg>
      </button>
    </header>

    <article>
      <div class="case-head">
        <p class="label"><a href="/#more-work" style="text-decoration:none">← More projects</a> · {p.name}</p>
        <h1 style="font-size:clamp(2.2rem,5.6vw,4.2rem)">{p.name}</h1>
        <p class="lede">{p.description}</p>
        <dl class="case-meta">
          <div><dt>Period</dt><dd>{p.year}</dd></div>
          <div><dt>Platforms</dt><dd>{p.platforms}</dd></div>
        </dl>
      </div>

      <section class="section" id="film" style="padding-top:clamp(48px,7vw,80px);scroll-margin-top:80px" aria-label="Product film">
        <figure class="film">
          <video controls playsinline preload="none" poster={film.poster} aria-label={film.title}>
            <source src={film.src} type="video/mp4" />
          </video>
          <figcaption><span class="film-len">{film.length}</span> {film.caption}</figcaption>
        </figure>
      </section>

      <section class="section" style="padding-top:clamp(48px,7vw,80px)" aria-labelledby="built-title">
        <div class="section-head">
          <p class="label">What I built</p>
          <h2 id="built-title">The app</h2>
        </div>
        <ul class="highlights">
          {p.points.map((h) => <li>{h}</li>)}
        </ul>
      </section>

      <nav class="next-case section" style="padding-top:22px;margin-top:clamp(56px,8vw,96px)" aria-label="More projects">
        <span class="label">More projects</span>
        <a class="btn btn-ghost" href="/#more-work">See the other apps →</a>
      </nav>
    </article>

    <footer class="footer">
      <span>© {new Date().getFullYear()} {profile.fullName}</span>
      <a href="/#contact">Contact</a>
    </footer>
  </main>
</Base>
